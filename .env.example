# ========================================
# PbHub HRMS — Environment Configuration
# ========================================
# Copy this file to .env and update values.
# Do NOT commit .env to version control.

# ---- General ----
NODE_ENV=development

# ---- API ----
APP_PORT=3001
API_BASE_URL=http://localhost:3001

# ---- Web ----
WEB_PORT=3000
APP_BASE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# ---- Database ----
DB_HOST=localhost
DB_PORT=5432
DB_USER=hrms
DB_PASSWORD=hrms_password
DB_NAME=hrms_db
DATABASE_URL=postgresql://hrms:hrms_password@localhost:5432/hrms_db

# ---- Redis ----
REDIS_URL=redis://localhost:6379

# ---- JWT ----
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ---- Storage ----
STORAGE_DRIVER=local
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
