{
  "name": "@pbhub/infra",
  "version": "0.1.0",
  "private": true,
  "description": "AWS CDK infrastructure for PbHub HRMS",
  "bin": {
    "pbhub-infra": "bin/pbhub.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "jest",
    "cdk": "cdk",
    "synth": "cdk synth",
    "diff": "cdk diff",
    "deploy": "cdk deploy",
    "deploy:storage:dev": "cdk deploy PbHub-Storage-dev --profile pb.hub",
    "deploy:storage:prod": "cdk deploy PbHub-Storage-prod --profile pb.hub --require-approval broadening"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.0",
    "aws-cdk": "^2.150.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.150.0",
    "constructs": "^10.3.0",
    "source-map-support": "^0.5.21"
  }
}
