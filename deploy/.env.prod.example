# ─────────────────────────────────────────────────────────────────────────────
# Production environment template.
#
# Copy this file to `.env.prod` next to docker-compose.prod.yml and fill in
# every value. NEVER commit `.env.prod` — it's in deploy/.gitignore.
#
# Generate strong secrets with:  openssl rand -base64 48
# ─────────────────────────────────────────────────────────────────────────────

# === Domain & URLs (same value used by both nginx and the apps) ==============
DOMAIN=hr.cloudxbloom.com
APP_BASE_URL=https://hr.cloudxbloom.com
API_BASE_URL=https://hr.cloudxbloom.com

# === PostgreSQL =============================================================
DB_USER=hrms
# Strong, random — `openssl rand -base64 32`
DB_PASSWORD=CHANGE_ME_LONG_RANDOM_STRING
DB_NAME=hrms_db
DATABASE_URL=postgresql://hrms:CHANGE_ME_LONG_RANDOM_STRING@postgres:5432/hrms_db

# === Redis ==================================================================
REDIS_URL=redis://redis:6379

# === JWT secrets (different for prod than dev — DO NOT REUSE) ===============
JWT_ACCESS_SECRET=CHANGE_ME_64_CHAR_RANDOM
JWT_REFRESH_SECRET=CHANGE_ME_DIFFERENT_64_CHAR_RANDOM
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# === S3 storage (CDK stack output: PbHub-Storage-prod) ======================
STORAGE_DRIVER=s3
S3_BUCKET=pbhub-prod
S3_REGION=us-east-1
# Generated from the IAM user the CDK stack creates (`pbhub-app-prod`).
# Console → IAM → Users → pbhub-app-prod → Security credentials → Create access key.
# Prefer a task role (compute-stack TODO) once we move to ECS.
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME

# === Mail (Gmail SMTP for now; switch to SES once volume grows) =============
MAIL_TRANSPORT=smtp
MAIL_FROM=PbHub HRMS <noreply@hr.cloudxbloom.com>
MAIL_SMTP_HOST=smtp.gmail.com
MAIL_SMTP_PORT=587
MAIL_SMTP_USER=your-gmail@gmail.com
# Google App Password (NOT your regular gmail password)
# https://myaccount.google.com/apppasswords
MAIL_SMTP_PASSWORD=CHANGE_ME
MAIL_SMTP_SECURE=false

# === Let's Encrypt ==========================================================
LETSENCRYPT_EMAIL=navaidrasheed221@gmail.com
